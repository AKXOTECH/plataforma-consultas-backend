{
  "compilerOptions": {
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "paths": {
      "@config/*": ["./src/config/*"],
      "@modules/*": ["./src/modules/*"],
      "@providers/*": ["./src/providers/*"],
      "@repositories/*": ["./src/repositories/*"],
      "@models/*": ["./src/models/*"],
      "@shared/*": ["./src/shared/*"],
      "@types/*": ["./src/types/*"]
    },
    "module": "commonjs",
    "target": "es2022",
    "types": [],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
