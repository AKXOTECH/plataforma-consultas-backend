HOST=0.0.0.0
PORT=3333
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/consulta_veicular

# ─── JWT ───────────────────────────────────────
JWT_SECRET=senha_forte_aqui
JWT_EXPIRES_IN=7d

# ─── API Externa (Provedor de Consultas) ───────
API_BASE_URL=base_aqui
API_TOKEN=seu_token_aqui

# ─── Rate Limit ────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Frontend (CORS) ────────────────────────────
FRONTEND_URL=https://seu-frontend.vercel.app

# ─── Regras financeiras (conforme escopo) ──────
MIN_OPERATIONAL_COST=500
DEV_PROFIT_SHARE=0.20
DEV_PROFIT_CAP=2000

